# Build output
/build/
/build-*/
/cmake-build-*/
/out/
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib

# The build, packaging and verification scripts are shared, because a fix to how
# the app is packaged is a fix to the project and not to one machine. They take
# every toolchain path from the environment and fall back to the defaults below,
# so they run unchanged on a machine that has them somewhere else.
#
# What is left ignored here is the throwaway instrumentation: one-off probes
# written to answer a single question, which measure nothing once the question
# has been answered.
/tools/*

# Third-party dependency caches (JunctionBox and friends). These are
# machine-specific and must never be committed.
.cache/

# CMake and Qt generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
compile_commands.json
_autogen/
.qmake.stash
*.qmlc

# IDE metadata
.vscode/
.idea/
*.user
*.user.*

# Local model files and app data
/models/
/data/
*.gguf
*.engine
*.plan
*.safetensors

# Kestrel engine build records, which sit beside their engine
*.kestrel-engine

# OS files
.DS_Store
Thumbs.db

# Freebuff agent worktrees
.freebuff/

# Generated audio comparisons. These are rendered from a downloaded speech
# model, so they are an artefact of running the voice locally rather than
# something the repository should carry.
voice-samples/

# Window captures taken while reviewing a UI change. Same reasoning: they
# record one machine's screen at one moment, and the reasoning they support
# belongs in the commit message rather than in the tree.
audit/
