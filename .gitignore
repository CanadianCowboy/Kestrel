# Build output
/build/
/build-*/
/cmake-build-*/
/out/
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib

# Local developer helper scripts. These wrap machine-specific toolchain paths
# (Visual Studio, Qt, CUDA) and are intentionally not shared.
/tools/

# Third-party dependency caches (JunctionBox and friends). These are
# machine-specific and must never be committed.
.cache/

# CMake and Qt generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
compile_commands.json
_autogen/
.qmake.stash
*.qmlc

# IDE metadata
.vscode/
.idea/
*.user
*.user.*

# Local model files and app data
/models/
/data/
*.gguf
*.engine
*.plan
*.safetensors

# Kestrel engine build records, which sit beside their engine
*.kestrel-engine

# OS files
.DS_Store
Thumbs.db
